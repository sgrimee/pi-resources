{
  "name": "pi-resources",
  "version": "0.1.0",
  "description": "Browse loaded Pi context files, skills, prompt templates, and extensions on demand",
  "type": "module",
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run check"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package",
    "resources",
    "skills",
    "terminal-ui"
  ],
  "author": "Sam Grimee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sgrimee/pi-resources.git"
  },
  "bugs": {
    "url": "https://github.com/sgrimee/pi-resources/issues"
  },
  "homepage": "https://github.com/sgrimee/pi-resources#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
